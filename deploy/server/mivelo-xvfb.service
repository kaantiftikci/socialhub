# Mivelo — sanal ekran (Xvfb :99). Sunucu çekirdeklerinin Chromium'ları giriş ekranlarını burada görünür (headful) modda
# çizer; siteler görünmez (headless) tarayıcıyı daha sık reddediyor. Kimse bu ekranı görmez: görüntü Mivelo içi girişe yayınlanır.
# İstemciler soyut soketten (@/tmp/.X11-unix/X99) bağlanır: ağ geçidinin PrivateTmp'i engel değil.
[Unit]
Description=Mivelo sanal ekran (Xvfb :99)
After=network.target

[Service]
Type=simple
User=mivelo
Group=mivelo
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x900x24 -nolisten tcp
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
