    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "pino": "^9.7.0",
    "playwright": "^1.52.0",
    "qrcode": "^1.5.4",
    "teleproto": "^1.229.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
