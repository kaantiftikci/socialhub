{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kavşak",
  "version": "0.1.0",
  "identifier": "app.kavsak.desktop",
  "build": {
    "beforeDevCommand": "cd ../.. && npm run build -w packages/core && npm run dev -w apps/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../.. && npm run build -w packages/core && npm run build -w apps/web && node scripts/bundle-core.mjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kavşak",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#111016",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Tüm mesajlaşma kanalların için tek gelen kutusu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "core-bundle": "core"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
