{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "cd ..\\.. && npm run build -w packages/core && npm run dev -w apps/web",
    "beforeBuildCommand": "cd ..\\.. && npm run build -w packages/core && npm run build -w apps/web && node scripts/bundle-core.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mivelo",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#111016",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
